
+ # Normalize text files to LF across the repository
+ * text=auto eol=lf
+ 
+ # Unity text asset formats
+ *.cs text eol=lf
+ *.shader text eol=lf
+ *.cginc text eol=lf
+ *.hlsl text eol=lf
+ *.json text eol=lf
+ *.yml text eol=lf
+ *.yaml text eol=lf
+ *.txt text eol=lf
+ *.md text eol=lf
+ *.xml text eol=lf
+ *.asmdef text eol=lf
+ *.mat text eol=lf
+ *.meta text eol=lf
+ *.unity text eol=lf
+ *.prefab text eol=lf
+ *.asset text eol=lf
+ *.anim text eol=lf
+ *.controller text eol=lf
+ *.mask text eol=lf
+ *.dae text eol=lf
+ 
+ # Binary files should not be normalized
+ *.png binary
+ *.jpg binary
+ *.jpeg binary
+ *.gif binary
+ *.mp3 binary
+ *.wav binary
+ *.ogg binary
+ *.fbx binary
+ *.unitypackage binary
+ *.dll binary
+ *.exe binary
+ *.jar binary
+ *.zip binary
+ *.unitypackage binary
+ 

  